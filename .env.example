# Zoom App Credentials (from Zoom Marketplace)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URL=https://your-server-domain/api/auth/callback
ZOOM_SECRET_TOKEN=

# Session
SESSION_SECRET=change-me-to-a-random-string

# Database
DATABASE_URL=file:./dev.db

# AWS Bedrock (fallback if CREATE AI is unavailable)
AWS_REGION=us-east-1

# CREATE AI (optional — primary AI backend, falls back to Bedrock if not set)
CREATE_AI_API_URL=https://api-main.aiml.asu.edu/query
CREATE_AI_TOKEN=
CREATE_AI_PRIMARY_MODEL=gemini-pro
CREATE_AI_BACKUP_MODEL=claude-3-opus

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
